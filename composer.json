{
    "name": "estebanforge/unrepress",
    "description": "WordPress plugin to obtain updates directly from git providers (like GitHub, BitBucket or GitLab)",
    "version": "0.7.0",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Esteban Cuevas",
            "email": "esteban@attitude.cl"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-mutate": "^4.0",
        "brain/monkey": "^2.7"
    },
    "scripts": {
        "test": "pest",
        "test:unit": "pest --testsuite=Unit",
        "test:integration": "pest --testsuite=Integration",
        "test:coverage": "pest --coverage",
        "version-bump": [
            "php .ci/version-bump.php"
        ],
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "production": [
            "php-cs-fixer fix",
            "composer install --no-dev",
            "composer dump-autoload --optimize"
        ]
    },
    "autoload": {
        "psr-4": {
            "UnrePress\\": "src/"
        },
        "classmap": [
            "src/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "UnrePress\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "composer/installers": true
        }
    },
    "extra": {
        "strauss": {
            "target_directory": "vendor-dist",
            "namespace_prefix": "EstebanForge\\UnrePress\\",
            "classmap_prefix": "ESFR_",
            "constant_prefix": "ESFR_",
            "packages": [],
            "override_autoload": [],
            "delete_vendor_packages": true
        }
    }
}
